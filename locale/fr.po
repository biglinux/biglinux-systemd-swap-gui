# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 105
#: src/biglinux_swap/ui/welcome_dialog.py:96
msgid ""
"Swap is like an extension of your computer's memory. When RAM is full, less-used data moves to "
"swap, preventing freezes."
msgstr ""
"Le Swap est comme une extension de la mémoire de votre ordinateur. Lorsque la RAM est pleine, les "
"données moins utilisées passent au swap, évitant les blocages."
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 110
#: src/biglinux_swap/ui/welcome_dialog.py:101
msgid "What is Zram?"
msgstr "Qu'est-ce que Zram ?"
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 112
#: src/biglinux_swap/ui/welcome_dialog.py:103
msgid ""
"Zram creates a compressed block device in RAM. It's faster than disk swap and perfect for systems "
"with limited disk speed."
msgstr ""
"Zram crée un périphérique bloc compressé en RAM. C'est plus rapide que l'échange sur disque et "
"parfait pour les systèmes avec une vitesse de disque limitée."
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 130
#: src/biglinux_swap/ui/welcome_dialog.py:121
msgid "What is Zswap?"
msgstr "Qu'est-ce que Zswap ?"
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 132
#: src/biglinux_swap/ui/welcome_dialog.py:123
msgid ""
"Zswap captures swap attempts and compresses pages into a RAM cache pool before they hit the disk, "
"reducing I/O."
msgstr ""
"Zswap capture les tentatives d'échange et compresse les pages dans un pool de cache RAM avant "
"qu'elles n'atteignent le disque, réduisant les E/S."
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
