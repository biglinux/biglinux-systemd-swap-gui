msgid "What is Swap?"
msgstr "Čo je Swap?"
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 105
#: src/biglinux_swap/ui/welcome_dialog.py:96
msgid ""
"Swap is like an extension of your computer's memory. When RAM is full, less-used data moves to "
"swap, preventing freezes."
msgstr ""
"Swap je ako rozšírenie pamäte vášho počítača. Keď je RAM plná, menej používané dáta sa presunú do "
"swapu, čo zabráni zamrznutiu."
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 110
#: src/biglinux_swap/ui/welcome_dialog.py:101
msgid "What is Zram?"
msgstr "Čo je Zram?"
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 112
#: src/biglinux_swap/ui/welcome_dialog.py:103
msgid ""
"Zram creates a compressed block device in RAM. It's faster than disk swap and perfect for systems "
"with limited disk speed."
msgstr ""
"Zram vytvára komprimované blokové zariadenie v RAM. Je rýchlejšie ako diskový swap a ideálne pre "
"systémy s obmedzenou rýchlosťou disku."
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 130
#: src/biglinux_swap/ui/welcome_dialog.py:121
msgid "What is Zswap?"
msgstr "Čo je Zswap?"
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 132
#: src/biglinux_swap/ui/welcome_dialog.py:123
msgid ""
"Zswap captures swap attempts and compresses pages into a RAM cache pool before they hit the disk, "
"reducing I/O."
msgstr ""
"Zswap zachytáva pokusy o swap a komprimuje stránky do fondu vyrovnávacej pamäte RAM predtým, ako sa "
"dostanú na disk, čím sa znižuje I/O."
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 137
#: src/biglinux_swap/ui/welcome_dialog.py:128
msgid "Automatic Mode"
msgstr "Automatický režim"
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 139
#: src/biglinux_swap/ui/welcome_dialog.py:130
msgid ""
"Recommended: Auto mode detects your hardware (RAM + Storage) and applies the optimal configuration "
"automatically."
msgstr ""
"Odporúčané: Režim Auto rozpozná váš hardvér (RAM + úložisko) a použije optimálnu konfiguráciu "
"automaticky."
