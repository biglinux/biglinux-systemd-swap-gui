msgid "Welcome"
msgstr "ברוך הבא"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 103
msgid "What is Swap?"
msgstr "מה זה סוויפ?"
