msgstr "Virktakt kerfisnotkunarupplýsingar"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 230
msgid "RAM Total"
msgstr "RAM Heildar"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 233
msgid "RAM Used"
msgstr "RAM notuð"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 236
msgid "RAM Available"
msgstr "RAM í boði"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 239
msgid "Buffers / Cache"
msgstr "Púður / Skammtar"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 243
msgid "Swap Total"
msgstr "Samtalskipt"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 246
msgid "Swap in RAM"
msgstr "Skipta í RAM"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 249
msgid "Swap on Disk"
