msgid "Service Status"
msgstr "Status usluge"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 219
msgid "Current Mode"
msgstr "Trenutni način"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 225
msgid "Live Statistics"
msgstr "Žive statistike"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 226
msgid "Active system usage info"
msgstr "Informacije o aktivnoj upotrebi sustava"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 230
msgid "RAM Total"
msgstr "Ukupno RAM"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 233
msgid "RAM Used"
msgstr "Iskorišteni RAM"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 236
msgid "RAM Available"
msgstr "Dostupna RAM"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 239
msgid "Buffers / Cache"
msgstr "Baferi / Keš"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 243
msgid "Swap Total"
msgstr "Zbroj zamjena"
# 
