# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 39
# File: biglinux-systemd-swap-gui/src/biglinux_swap/window.py, line: 136
msgid "Welcome"
msgstr "Üdvözöljük"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 103
msgid "What is Swap?"
msgstr ""
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 105
msgid ""
"Swap is like an extension of of your computer's memory. When RAM is full, less-used data moves to "
"swap, preventing freezes."
msgstr ""
"A csere a számítógép memóriájának kiterjesztéseként működik. Amikor a RAM megtelik, a ritkábban "
"használt adatok a cserére kerülnek, megakadályozva a lefagyásokat."
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 110
msgid "What is Zram?"
msgstr "Zram mi az?"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 112
msgid ""
"Zram creates a compressed block device in RAM. It's faster than disk swap and perfect for systems "
"with limited disk speed."
msgstr ""
"A Zram tömörített blokk eszközt hoz létre a RAM-ban. Gyorsabb, mint a lemezcsere, és tökéletes "
"korlátozott lemezsebességű rendszerekhez."
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 130
msgid "What is Zswap?"
msgstr "Zswap mi az?"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 132
msgid ""
"Zswap captures swap attempts and compresses pages into a RAM cache pool before they hit the disk, "
"reducing I/O."
msgstr ""
"A Zswap rögzíti a swap kísérleteket, és a lapokat egy RAM gyorsítótárba tömöríti, mielőtt azok a "
"lemezre kerülnének, csökkentve ezzel a I/O-t."
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 137
msgid "Automatic Mode"
msgstr "Automatikus mód"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 139
msgid ""
"Recommended: Auto mode detects your hardware (RAM + Storage) and applies the optimal configuration "
"automatically."
msgstr ""
"Ajánlott: Az automatikus mód észleli a hardverét (RAM + Tárhely) és automatikusan alkalmazza az "
"optimális konfigurációt."
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 160
msgid "Show dialog on startup"
msgstr "Indítsa el a párbeszédpanelt a rendszerindításkor."
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 179
msgid "Let's Start"
msgstr "Kezdjük el"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 211
msgid "Service Status"
msgstr "Szolgáltatás állapota"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 219
msgid "Current Mode"
msgstr "Jelenlegi mód"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 225
msgid "Live Statistics"
msgstr "Élő statisztikák"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/unified_view.py, line: 226
msgid "Active system usage info"
