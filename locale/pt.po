#: src/biglinux_swap/ui/welcome_dialog.py:94
msgid "What is Swap?"
msgstr "O que é Swap?"
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 105
#: src/biglinux_swap/ui/welcome_dialog.py:96
msgid ""
"Swap is like an extension of your computer's memory. When RAM is full, less-used data moves to "
"swap, preventing freezes."
msgstr ""
"O Swap é como uma extensão da memória do seu computador. Quando a RAM está cheia, dados menos "
"usados vão para o swap, prevenindo travamentos."
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 110
#: src/biglinux_swap/ui/welcome_dialog.py:101
msgid "What is Zram?"
msgstr "O que é Zram?"
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 112
#: src/biglinux_swap/ui/welcome_dialog.py:103
msgid ""
"Zram creates a compressed block device in RAM. It's faster than disk swap and perfect for systems "
"with limited disk speed."
msgstr ""
"O Zram cria um dispositivo de bloco comprimido na RAM. É mais rápido que o swap em disco e perfeito "
"para sistemas com velocidade de disco limitada."
