# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 105
#: src/biglinux_swap/ui/welcome_dialog.py:96
msgid ""
"Swap is like an extension of your computer's memory. When RAM is full, less-used data moves to "
"swap, preventing freezes."
msgstr ""
"Swap ist wie eine Erweiterung des Arbeitsspeichers Ihres Computers. Wenn der RAM voll ist, werden "
"weniger genutzte Daten in den Swap verschoben, was Einfrieren verhindert."
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 110
#: src/biglinux_swap/ui/welcome_dialog.py:101
msgid "What is Zram?"
msgstr "Was ist Zram?"
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 112
#: src/biglinux_swap/ui/welcome_dialog.py:103
msgid ""
"Zram creates a compressed block device in RAM. It's faster than disk swap and perfect for systems "
"with limited disk speed."
msgstr ""
"Zram erstellt ein komprimiertes Blockgerät im RAM. Es ist schneller als Festplatten-Swap und "
"perfekt für Systeme mit begrenzter Festplattengeschwindigkeit."
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 130
#: src/biglinux_swap/ui/welcome_dialog.py:121
msgid "What is Zswap?"
msgstr "Was ist Zswap?"
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 132
#: src/biglinux_swap/ui/welcome_dialog.py:123
msgid ""
"Zswap captures swap attempts and compresses pages into a RAM cache pool before they hit the disk, "
"reducing I/O."
msgstr ""
"Zswap fängt Swap-Versuche ab und komprimiert Seiten in einen RAM-Cache-Pool, bevor sie die "
"Festplatte erreichen, was die E/A reduziert."
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
