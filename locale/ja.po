# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 105
#: src/biglinux_swap/ui/welcome_dialog.py:96
#, fuzzy
msgid ""
"Swap is like an extension of your computer's memory. When RAM is full, less-"
"used data moves to swap, preventing freezes."
msgstr ""
"スワップはコンピュータのメモリの拡張のようなものです。RAM がいっぱいになると、あまり使用されていないデータがスワップに移動し、フリーズを防ぎます。"

# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 110
#: src/biglinux_swap/ui/welcome_dialog.py:101
msgid "What is Zram?"
msgstr "Zram とは?"

# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 112
#: src/biglinux_swap/ui/welcome_dialog.py:103
msgid ""
"Zram creates a compressed block device in RAM. It's faster than disk swap "
"and perfect for systems with limited disk speed."
msgstr "Zram は RAM 内に圧縮ブロックデバイスを作成します。ディスクスワップよりも高速で、ディスク速度が制限されているシステムに最適です。"

# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 130
#: src/biglinux_swap/ui/welcome_dialog.py:121
msgid "What is Zswap?"
msgstr "Zswap とは?"

# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py,
# line: 132
#: src/biglinux_swap/ui/welcome_dialog.py:123
msgid ""
"Zswap captures swap attempts and compresses pages into a RAM cache pool "
"before they hit the disk, reducing I/O."
msgstr "Zswap はスワップ試行をキャプチャし、ディスクに到達する前にページを圧縮して RAM キャッシュプールに入れ、I/O を削減します。"

