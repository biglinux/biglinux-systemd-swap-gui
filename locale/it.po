# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 103
msgid "What is Swap?"
msgstr "Cos'è Swap?"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 105
msgid ""
"Swap is like an extension of of your computer's memory. When RAM is full, less-used data moves to "
"swap, preventing freezes."
msgstr ""
"Lo swap è come un'estensione della memoria del tuo computer. Quando la RAM è piena, i dati meno "
"utilizzati vengono spostati nello swap, prevenendo i blocchi."
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 110
msgid "What is Zram?"
msgstr ""
"Zram è un modulo del kernel Linux che crea un dispositivo di blocco compresso in memoria, "
"consentendo di utilizzare la RAM in modo più efficiente."
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 112
msgid ""
"Zram creates a compressed block device in RAM. It's faster than disk swap and perfect for systems "
"with limited disk speed."
msgstr ""
"Zram crea un dispositivo a blocchi compresso nella RAM. È più veloce dello swap su disco ed è "
"perfetto per sistemi con velocità di disco limitata."
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 130
msgid "What is Zswap?"
msgstr ""
"Zswap è un sistema di compressione della memoria per Linux che consente di comprimere le pagine di "
"memoria che vengono scambiate su disco, migliorando l'efficienza dell'uso della memoria e riducendo "
"il tempo di accesso ai dati."
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 132
msgid ""
"Zswap captures swap attempts and compresses pages into a RAM cache pool before they hit the disk, "
"reducing I/O."
msgstr ""
"Zswap cattura i tentativi di swap e comprime le pagine in un pool di cache RAM prima che "
"raggiungano il disco, riducendo l'I/O."
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 137
msgid "Automatic Mode"
msgstr "Modalità Automatica"
# 
# File: biglinux-systemd-swap-gui/src/biglinux_swap/ui/welcome_dialog.py, line: 139
msgid ""
"Recommended: Auto mode detects your hardware (RAM + Storage) and applies the optimal configuration "
"automatically."
msgstr ""
"Consigliato: La modalità automatica rileva l'hardware (RAM + Archiviazione) e applica "
"automaticamente la configurazione ottimale."
# 
